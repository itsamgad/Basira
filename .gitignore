# Transient working space — contents are moved into basira-engine/ and _archive/ during cleanup phases.
_staging/

# macOS / zip junk
.DS_Store
__MACOSX/

# Large archive contents — moved into _archive/ but not worth tracking
_archive/zips/
_archive/scraper/**/node_modules/
_archive/scraper/**/*.zip
_archive/scraper/**/out/
_archive/scraper/**/.next/

# Redundant duplicate of basira-engine/ contents — already tracked there and
# in the init-commit zip. Kept on-disk for reversibility, not in git.
_archive/redundant-final-model/Basira Final model/
_archive/redundant-final-model/_staging-emptied/

# Python virtualenv + bytecode cache (created during local verification)
.venv/
__pycache__/
*.pyc

# Launcher runtime logs (Basira.command writes engine.log + scraper.log here)
logs/

# Icon-build intermediates (basira-icon-source.png + Basira.icns are
# produced during the .app bundle build via sips + iconutil; the final
# icon is committed inside Basira.app/Contents/Resources/AppIcon.icns).
build/

# Installer ZIPs ARE tracked (payload for marketing site downloads).
# Rebuild with: zip commands documented in basira-website/README.md
# (kept in-repo so Vercel can serve them directly via relative URL).

# Scraper runtime artifacts (per-job exports + history log)
basira-scraper/scrape_outputs/
basira-scraper/scrape_history.json

# Engine runtime artifacts (uploaded files + per-run outputs)
basira-engine/outputs/
basira-engine/uploads/
